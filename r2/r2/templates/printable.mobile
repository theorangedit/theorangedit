{# template import (inject via context): from r2.lib.pages import WrappedUser #}

<li>
  {{ self.parent() }}
  {{ self.entry() }}
  {{ self.Child() }}
</li>


    
{% macro parent() %}
{% endmacro %}

{% macro Child() %}
  {% if hasattr(thing, "child") %}
    <div id="child_{{ thing._fullname }}" class="child">
     {{ thing.child }}
    </div>
  {% endif %}
{% endmacro %}

{% macro entry() %}
{% endmacro %}

{% macro author(friend = False, gray = False) %}
  {{ WrappedUser(thing.author, thing.attribs, thing, gray = collapse) }}
{% endmacro %}

{% macro score(this, likes=None, inline=True, label = True, _id = True) %}
{% endmacro %}

{% macro delete_or_report_buttons(delete=True, report=True) %}
{% endmacro %}


{% macro buttons() %}
{% endmacro %}
